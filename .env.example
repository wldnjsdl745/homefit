# Frontend -> AI server
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_CHAT=false

# AI server -> Backend
BACKEND_URL=http://backend:8080
AI_BACKEND_MODE=http
AI_DUMMY_FAIL=false
AI_TIMEOUT_MS=5000
CORS_ALLOW_ORIGINS=http://localhost:5173

# Docker MySQL
MYSQL_DATABASE=homefit
MYSQL_USER=homefit
MYSQL_PASSWORD=homefit
MYSQL_ROOT_PASSWORD=homefit-root
MYSQL_HOST_PORT=3307

# Backend -> Docker MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/homefit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=homefit
SPRING_DATASOURCE_PASSWORD=homefit
