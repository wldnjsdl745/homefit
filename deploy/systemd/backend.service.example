[Unit]
Description=Homefit Spring Boot Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homefit
Group=homefit
WorkingDirectory=/opt/homefit/backend
LogsDirectory=homefit

Environment="SPRING_DATASOURCE_URL=jdbc:mysql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/homefit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
Environment="SPRING_DATASOURCE_USERNAME=homefit"
Environment="SPRING_DATASOURCE_PASSWORD=change-me"
# Use only when adopting an existing RDS schema that already matches V1~V3 migrations.
# Environment="SPRING_FLYWAY_BASELINE_ON_MIGRATE=true"
# Environment="SPRING_FLYWAY_BASELINE_VERSION=3"
Environment="JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m"

ExecStart=/usr/bin/java -jar /opt/homefit/backend/app.jar
Restart=always
RestartSec=5

StandardOutput=append:/var/log/homefit/backend.log
StandardError=append:/var/log/homefit/backend-error.log

[Install]
WantedBy=multi-user.target
