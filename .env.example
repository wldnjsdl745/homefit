# ─── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_CHAT=false

# ─── AI server ↔ Backend ───────────────────────────────────
BACKEND_URL=http://backend:8080
AI_BACKEND_MODE=http
AI_DUMMY_FAIL=false
AI_TIMEOUT_MS=5000
CORS_ALLOW_ORIGINS=http://localhost:5173

# ─── AI server LLM (OpenRouter) ────────────────────────────
# AI_PROVIDER:
#   - openai_compatible (or qwen): OpenAI 호환 /v1/chat/completions (OpenRouter, Claude, GPT 등)
#   - ollama_native (or qwen_native): Ollama /api/chat + think:false (로컬 Ollama용)
#   - dummy: LLM 미호출
AI_PROVIDER=openai_compatible

# OpenRouter (https://openrouter.ai)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-_여기에_본인_OpenRouter_키_붙여넣기_
# 모델 추천:
#   - deepseek/deepseek-v4-flash:free     무료, 현재 기본값
#   - openrouter/free                     무료 모델 라우터
#   - meta-llama/llama-3.3-70b-instruct:free  무료
#   - anthropic/claude-haiku-4.5          유료 $0.25/1M, 빠르고 정확
#   - openai/gpt-4o-mini                  유료 $0.15/1M
#   - google/gemini-2.5-flash             유료 $0.10/1M
OPENAI_MODEL=deepseek/deepseek-v4-flash:free

# LLM 호출 타임아웃 (ms). OpenRouter는 보통 5-15초.
LLM_TIMEOUT_MS=30000
LLM_PROMPT_STYLE=hermes

# (선택) OpenRouter 분석/랭킹용. 비워둬도 동작.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Homefit

# ─── Docker MySQL ──────────────────────────────────────────
MYSQL_DATABASE=homefit
MYSQL_USER=homefit
MYSQL_PASSWORD=homefit
MYSQL_ROOT_PASSWORD=homefit-root
MYSQL_HOST_PORT=3307

# ─── Backend → Docker MySQL ───────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/homefit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=homefit
SPRING_DATASOURCE_PASSWORD=homefit
